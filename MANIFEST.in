include README.md pyproject.toml MANIFEST.in
include requirements-dev.txt
recursive-include src/sentinel *.py
recursive-include docs *.md
recursive-include tests *.py
recursive-include tools *.py
prune .venv
prune .venv-ci
prune .git
prune .pytest_cache
prune .ruff_cache
prune .mypy_cache
prune build
prune dist
global-exclude *.py[cod] .env .env.* .DS_Store *~
